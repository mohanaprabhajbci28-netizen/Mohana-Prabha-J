#include <ctype.h>
#include <string.h>

int calculate(char* s) {
    if (s == NULL || strlen(s) == 0) return 0;
    
    long long currentNumber = 0;
    long long lastNumber = 0;
    long long result = 0;
    char sign = '+';
    
    int len = strlen(s);
    for (int i = 0; i < len; i++) {
        char c = s[i];
        
        if (isdigit(c)) {
            currentNumber = currentNumber * 10 + (c - '0');
        }
        
        // Process when we hit an operator or the end of the string
        if ((!isdigit(c) && c != ' ') || i == len - 1) {
            if (sign == '+') {
                result += lastNumber;
                lastNumber = currentNumber;
            } else if (sign == '-') {
                result += lastNumber;
                lastNumber = -currentNumber;
            } else if (sign == '*') {
                lastNumber = lastNumber * currentNumber;
            } else if (sign == '/') {
                lastNumber = lastNumber / currentNumber;
            }
            
            sign = c;
            currentNumber = 0;
        }
    }
    
    result += lastNumber;
    return (int)result;
}
