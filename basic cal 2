#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>
int calculate(char* s) {
    int len = strlen(s);
    int res = 0;
    int sign = 1; // 1 means '+', -1 means '-'
    
    // Simple stack implementation using an array
    int* stack = (int*)malloc(sizeof(int) * len);
    int top = -1;

    for (int i = 0; i < len; i++) {
        char c = s[i];

        if (isdigit(c)) {
            long long num = 0;
            // Form the complete multi-digit number
            while (i < len && isdigit(s[i])) {
                num = num * 10 + (s[i] - '0');
                i++;
            }
            i--; // Step back since the outer loop increments i
            res += sign * num;
        } 
        else if (c == '+') {
            sign = 1;
        } 
        else if (c == '-') {
            sign = -1;
        } 
        else if (c == '(') {
            // Push current result and current sign to the stack
            stack[++top] = res;
            stack[++top] = sign;
            // Reset result and sign for the new sub-expression
            res = 0;
            sign = 1;
        } 
        else if (c == ')') {
            // Pop the sign applied to the entire parenthesis block
            int prev_sign = stack[top--];
            res *= prev_sign;
            // Pop the result calculated before entering the parenthesis
            int prev_res = stack[top--];
            res += prev_res;
        }
    }

    free(stack);
    return res;
    
}
