#include <stdio.h>
#include <stdlib.h> // Required for labs() or abs()

void update(int *a, int *b) {
    // Store original values before modification
    int temp_a = *a;
    int temp_b = *b;
    
    // Update value at address a with sum
    *a = temp_a + temp_b;
    
    // Update value at address b with absolute difference
    *b = abs(temp_a - temp_b);
}

int main() {
    int a, b;
    int *pa = &a, *pb = &b;
    
    // Read input values
    if (scanf("%d %d", &a, &b) == 2) {
        // Call the update function passing the pointers
        update(pa, pb);
        // Print the modified values
        printf("%d\n%d", a, b);
    }
    
    return 0;
}
