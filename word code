#include <stdbool.h>
#include <string.h>
#include <stdlib.h>
bool wordBreak(char* s, char** wordDict, int wordDictSize) {
    int n = strlen(s);
    
    // dp[i] will be true if s[0...i-1] can be segmented into dictionary words
    bool* dp = (bool*)calloc(n + 1, sizeof(bool));
    dp[0] = true; // Base case: empty string is valid

    for (int i = 1; i <= n; i++) {
        for (int j = 0; j < wordDictSize; j++) {
            int len = strlen(wordDict[j]);
            
            // Check if the word fits and the prefix before it is valid
            if (i >= len && dp[i - len]) {
                // Check if the substring matches the dictionary word
                if (strncmp(s + (i - len), wordDict[j], len) == 0) {
                    dp[i] = true;
                    break; // Move to the next index once a match is found
                }
            }
        }
    }

    bool result = dp[n];
    free(dp); // Free dynamically allocated memory
    return result;
    
}
